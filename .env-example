# LearnHarness web container. Copy to .env and fill in what you use.
# .env is gitignored and excluded from the Docker build context; it is never
# baked into the image. Compose also reads .env for ${VAR} substitution.

# --- Container runtime ---
# HTTP port inside the container. Compose publishes 127.0.0.1:3000 to this port.
PORT=3000
# Bind address. Keep 0.0.0.0 so the port is reachable from the host.
HOSTNAME=0.0.0.0
# Next runtime mode. Keep production.
NODE_ENV=production

# --- Storage ---
# Writable root for chats, graph ledgers, settings, prompts and debug output.
LH_DATA_DIR=/data
# Flat JSON {ENV_VAR: key} holding BYOK keys and the custom-endpoint binding.
LH_AUTH_FILE=/data/auth.json

# --- Access ---
# Extra host names the API accepts besides localhost and IP literals.
# Comma-separated, case-insensitive, port ignored, no wildcards.
LH_ALLOWED_HOSTS=localhost
# Ignore every env provider key and use only LH_AUTH_FILE (fresh-user simulation).
# LH_IGNORE_ENV_KEYS=1
# Desktop-shell only. Do NOT set these in the web container: they switch the
# server into trusted-window mode and the browser UI's /api calls will fail.
# LH_DESKTOP_SERVER=
# LH_DESKTOP_API_SECRET=

# --- Provider keys (BYOK) ---
# All keys are commented out. Uncomment and fill only the providers you use.
# Empty env keys count as present, so do not uncomment a key you will not set.
# Real env keys take precedence over keys saved in LH_AUTH_FILE.
# Names come from src/core/auth-keys.ts.
# Ant Ling.
# ANT_LING_API_KEY=
# Anthropic.
# ANTHROPIC_API_KEY=
# Baseten.
# BASETEN_API_KEY=
# Cerebras.
# CEREBRAS_API_KEY=
# DeepSeek.
# DEEPSEEK_API_KEY=
# Fireworks.
# FIREWORKS_API_KEY=
# Google (Gemini).
# GEMINI_API_KEY=
# Groq.
# GROQ_API_KEY=
# Hugging Face.
# HF_TOKEN=
# Kimi For Coding.
# KIMI_API_KEY=
# Meta.
# META_API_KEY=
# MiniMax.
# MINIMAX_API_KEY=
# MiniMax CN.
# MINIMAX_CN_API_KEY=
# Mistral.
# MISTRAL_API_KEY=
# Moonshot AI.
# MOONSHOT_API_KEY=
# Moonshot AI CN.
# MOONSHOT_CN_API_KEY=
# NVIDIA.
# NVIDIA_API_KEY=
# OpenAI.
# OPENAI_API_KEY=
# OpenCode Zen and OpenCode Go.
# OPENCODE_API_KEY=
# OpenRouter.
# OPENROUTER_API_KEY=
# Qwen Token Plan.
# QWEN_TOKEN_PLAN_API_KEY=
# Qwen Token Plan CN.
# QWEN_TOKEN_PLAN_CN_API_KEY=
# Radius.
# RADIUS_API_KEY=
# Together.
# TOGETHER_API_KEY=
# TypeSafe.
# TYPESAFE_API_KEY=
# Vercel AI Gateway.
# AI_GATEWAY_API_KEY=
# xAI.
# XAI_API_KEY=
# Xiaomi.
# XIAOMI_API_KEY=
# Xiaomi Token Plan AMS.
# XIAOMI_TOKEN_PLAN_AMS_API_KEY=
# Xiaomi Token Plan CN.
# XIAOMI_TOKEN_PLAN_CN_API_KEY=
# Xiaomi Token Plan SGP.
# XIAOMI_TOKEN_PLAN_SGP_API_KEY=
# Z.AI.
# ZAI_API_KEY=
# Z.AI Coding CN.
# ZAI_CODING_CN_API_KEY=
# Custom OpenAI-compatible endpoint key.
# CUSTOM_OPENAI_API_KEY=

# --- Other service keys ---
# Dictation token minting.
# DEEPGRAM_API_KEY=
# Search adapters. Without a Settings pin, the first keyed engine wins:
# Tavily, Brave, Exa, Firecrawl, Ollama. A pinned engine needs its own key.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# OLLAMA_API_KEY=

# --- Diagnostics ---
# 1 = save raw provider events under LH_DATA_DIR. May contain private content.
# LH_PROVIDER_EVENTS=1
# Comma-separated background roles to capture, or all. Private content.
# LH_BACKGROUND_CAPTURE=auditor
# Override the 100ms chat update flush interval (milliseconds).
# LH_UPDATE_FLUSH_MS=100
# Chrome/Chromium executable fallback for demo verification.
# CHROME_PATH=

# --- Build / test only (leave commented for the web container) ---
# Skips the Electron binary download during docker build. Set in the Dockerfile.
# ELECTRON_SKIP_BINARY_DOWNLOAD=1
# Electron dev: connect to an existing dev server instead of spawning one.
# LH_DEV_URL=http://localhost:3000
# Native plugin smoke tests: prebuilt standalone host and its approved digest.
# LH_STANDALONE=
# LH_STANDALONE_SHA256=
# LH_APPROVED_HOST_DIGEST=
# Native plugin smoke tests: Electron Node runtime and local Chrome executable.
# LH_NODE_RUNTIME=
# LH_TEST_CHROME=
# Plugin smoke gate: the rebuilt host/plugin payload is ready.
# LH_POLISH_BUILD_READY=1
# Test-only override for the packaged app's update feed.
# LH_UPDATE_FEED=
# File-path smoke test profile label.
# LH_FILE_PATH_PROFILE=
# Pi engine cache retention.
# PI_CACHE_RETENTION=
# Pi coding-agent profile directory.
# PI_CODING_AGENT_DIR=
# Test fixtures: force a plugin build failure, disable slower paths.
# FAIL_BUILD=
# NO_SLOW=
# Flashcards frontend test: output path for generated HTML fixture.
# FLASHCARDS_BROWSER_FIXTURE=
# Fake Claude CLI test switches.
# FAKE_CLAUDE_INIT=
# FAKE_CLAUDE_SCENARIO=
# FAKE_CLAUDE_STDIN=
# FAKE_CLAUDE_WINDOW=
# Offline provider/subscription test sentinels.
# LH_OFFLINE_ON_PAYLOAD=
# LH_OFFLINE_SUBSCRIPTION=
# Marks synthetic secrets in offline test payloads.
# LH_SYNTHETIC_SECRET_MARKER=
# Opaque file-only key used in auth-store tests; not a curated provider key.
# FUTURE_PLANS_TOKEN=

# --- Injected by the app or build (do not set here) ---
# Public build metadata from next.config.ts, baked into the bundle.
# LH_VERSION=
# LH_HOMEPAGE=
# Claude Code child env: forced to 1 to disable CLAUDE.md memory.
# CLAUDE_CODE_DISABLE_CLAUDE_MDS=1
# Claude Code CLI native profile directory.
# CLAUDE_CONFIG_DIR=
# Alternate Anthropic auth token read by the Claude Code CLI.
# ANTHROPIC_AUTH_TOKEN=
# GitHub Copilot SDK token.
# COPILOT_GITHUB_TOKEN=

# --- OS / runtime-provided (do not set here) ---
# Supplied by the OS or Node/Electron. Listed for completeness only.
# HOME=
# PATH=
# LANG=
# TZ=
# USERPROFILE=
# PROGRAMFILES=
# LOCALAPPDATA=
# ELECTRON_RUN_AS_NODE=
# NEXT_RUNTIME=
